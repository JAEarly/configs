[core]
	editor = hx
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	dark = true
	line-numbers = true

[diff]
	colorMoved = default

[push]
	autoSetupRemote = true

[alias]
	lg = log --graph --oneline --decorate --exclude=refs/remotes/origin/mike-docs --all
	count = "!f() { git rev-list --count $1..HEAD; }; f"
