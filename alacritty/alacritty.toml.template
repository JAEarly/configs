# $HOME/.config/alacritty/alacritty.toml
# This file is auto-generated by setup.sh - do not edit directly
# Edit alacritty/alacritty.toml.template instead

[general]
import = [
  "~/.config/alacritty/catppuccin-mocha.toml"
]

[window]
opacity = 1.0
padding.x =5
padding.y = 2
startup_mode = "Windowed"
option_as_alt = "None"

[keyboard]
bindings = [
  { key = "Left",  mods = "Alt",     chars = "\u001bB"   },
  { key = "Right", mods = "Alt",     chars = "\u001bF"   },
  { key = "Left",  mods = "Command", chars = "\u001bOH"  },
  { key = "Right", mods = "Command", chars =  "\u001bOF" },
  { key = "Back",  mods = "Command", chars = "\u0015"    },

  # Vim-style navigation (Command modifier)
  { key = "I", mods = "Command", chars = "\u001b[A" },  # Up arrow (previous command)
  { key = "K", mods = "Command", chars = "\u001b[B" },  # Down arrow (next command)
  { key = "J", mods = "Command", chars = "\u001b[D" },  # Left arrow (cursor left)
  { key = "L", mods = "Command", chars = "\u001b[C" },  # Right arrow (cursor right)

  # Vim-style navigation (Alt/Escape modifier)
  { key = "I", mods = "Alt", chars = "\u001b[A" },  # Up arrow (previous command)
  { key = "K", mods = "Alt", chars = "\u001b[B" },  # Down arrow (next command)
  { key = "J", mods = "Alt", chars = "\u001b[D" },  # Left arrow (cursor left)
  { key = "L", mods = "Alt", chars = "\u001b[C" },  # Right arrow (cursor right)
]

[terminal]
shell.program = "__ZELLIJ_PATH__"

[env]
TERM = "xterm-256color"
